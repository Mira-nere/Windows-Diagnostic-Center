#Monthly Maintenance Script

#Computer Information
$logfile = "C:\ITAutomation\Logs\MaintenanceLogs.txt"			            
$dandt = get-date -Format "MM:dd:yyyy HH:mm:ss"				                
$comname = $env:COMPUTERNAME						                              
$user = $env:USERNAME							                                    

#Windows OS Version
$wininf = get-ciminstance -classname win32_OperatingSystem | Select-object Caption, Version, BuildNumber, OSArchitecture   

#Output of Built-In Battery report
$batrep = "C:\ITAutomation\Logs\battery-report.html"                  

add-content -path $logfile -value "================================" 	
add-content -path $logfile -value "A Daily log has been generated!"		
add-content -path $logfile -value "As of $dandt"		                	
add-content -path $logfile -value "Computer: $comname"		          	
add-content -path $logfile -value "Username: $user `n"			              
add-content -path $logfile -value "$wininf `n"                            

#Battery Report
powercfg /batteryreport /output $batrep                                                 
add-content -path $logfile -value "The Battery report has been logged into $batrep `n"	                      
add-content -path $logfile -value "================================" 	#creates a border
