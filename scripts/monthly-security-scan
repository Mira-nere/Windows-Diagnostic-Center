#Monthly General log information

#Computer Information
$logfile = "C:\ITAutomation\Logs\MaintenanceLogs.txt"									 
$dandt = get-date -format "MM:dd:yyyy HH:mm:ss"											
$cname = $env:COMPUTERNAME																
$user = $env:USERNAME	

#Windows OS Version
$wininf = get-ciminstance -classname win32_OperatingSystem | Select-object Caption, Version, BuildNumber, OSArchitecture        

#File Header & Subheader texts
add-content -path $logfile -value "============================================"		
add-content -path $logfile -value "A Monthly log has been generated!"					
add-content -path $logfile -value "As of $dandt"										
add-content -path $logfile -value "Computer: $cname"									
add-content -path $logfile -value "Username: $user `n"					                        
add-content -path $logfile -value "$wininf `n"													

#Run Windows defender
update-mpsignature																		
start-mpscan -scantype fullscan						  									
add-content -path $logfile -value "Quick scan is completed! Check information for more"	

#Query threats after the scan finishes
$threats = get-mpthreatdetection														

#Capture the output																		
$scanRes = if ($threats) {
	"THREAD DETECTED!`n" + ($threats | Select-object ThreatName, InitialDetectionTime, Resources | Out-String)
}
else {
	"NO THREATS FOUND!" 
}

#Logs results in MPSCAN
add-content -path $logfile -value "$scanRes `n"											
add-content -path $logfile -value "============================================"		
