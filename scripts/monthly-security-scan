#Monthly General log information

$logfile = "C:\ITAutomation\Logs\MaintenanceLogs.txt"									#creates a variable for a directed log path  
$dandt = get-date -format "MM:dd:yyyy HH:mm:ss"											#creates a variable containing the value of date and time information, according to the specific format
$cname = $env:COMPUTERNAME																#creates a variable containing the value of current computer name
$user = $env:USERNAME																	#creates a variable containing the value of current user name
$wininf = get-ciminstance -classname win32_OperatingSystem | Select-object Caption, Version, BuildNumber, OSArchitecture         #variable for Winversion information

add-content -path $logfile -value "============================================"		#creates a border
add-content -path $logfile -value "A Monthly log has been generated!"					#added a printed text
add-content -path $logfile -value "As of $dandt"										#added a printed text + calling the variable
add-content -path $logfile -value "Computer: $cname"									#added a printed text + calling the variable
add-content -path $logfile -value "Username: $user"										#added a printed text + calling the variable
add-content -path $logfile -value ""													#gives space onto file

#Run Windows defender
update-mpsignature																		#updates anti-malware and anti-virus definition 
start-mpscan -scantype fullscan						  									#starts microsoft defender under fullscan
add-content -path $logfile -value "Quick scan is completed! Check information for more"	#added a printed text

#Query threats after the scan finishes
$threats = get-mpthreatdetection														#fetches the output of the scanning result under a defined variable

#Capture the output																		#Output variable for the if condition whether the results are good or bad
$scanRes = if ($threats) {
	"THREAD DETECTED!`n" + ($threats | Select-object ThreatName, InitialDetectionTime, Resources | Out-String)
}
else {
	"NO THREATS FOUND!" 
}

add-content -path $logfile -value "$scanRes"											#prints the output variable results
add-content -path $logfile -value "============================================"		#creates a border
