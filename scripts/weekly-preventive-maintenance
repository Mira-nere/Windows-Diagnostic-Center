#Weekly
$logfile = "C:\ITAutomation\Logs\MaintenanceLogs.txt"			            #creates a variable for a directed log path
$dandt = get-date -Format "MM:dd:yyyy HH:mm:ss"				                #creates a variable containing the value of date and time information, according to the specific format
$comname = $env:COMPUTERNAME						                              #creates a variable containing the value of current computer name
$user = $env:USERNAME							                                    #creates a variable containing the value of current user name
$wininf = get-ciminstance -classname win32_OperatingSystem | Select-object Caption, Version, BuildNumber, OSArchitecture         #variable for Winversion information
$disk = get-ciminstance -classname Win32_LogicalDisk -Filter "DeviceID='C:'"
$free = [math]::round($disk.FreeSpace / 1GB, 2)
$fdperc = [math]::round(($disk.FreeSpace / disk.Size)*100, 2)

add-content -path $logfile -value "================================" 	#creates a border
add-content -path $logfile -value "A Daily log has been generated!"		      #added a printed text
add-content -path $logfile -value "As of $dandt"		                	#added a printed text + calling the variable
add-content -path $logfile -value "Computer: $comname"		          	#added a printed text + calling the variable
add-content -path $logfile -value "Username: $user"			               #added a printed text + calling the variable
add-content -path $logfile -value ""					                        #gives space onto file
add-content -path $logfile -value $wininf                             #calling the variable
add-content -path $logfile -value ""					                        #gives space onto file

#Available Disk space
add-content -path $logfile -value "C: Drive Free Space: $free GB ($fdperc% free) `n"					   #gives space onto file

#SFC Scan
Clear-RecycleBin -Force							                                            #Clears the content of recycle bin
add-content -path $logfile -value "2. Recycle bin has been deleted permanently!"	#added a printed text
add-content -path $logfile -value "================================"	          #added a border

#DISM
