# Weekly Maintenance Script
$logfile = "C:\ITAutomation\Logs\MaintenanceLogs.txt"                         
$dandt   = Get-Date -Format "MM/dd/yyyy HH:mm:ss"                             
$comname = $env:COMPUTERNAME                                                  
$user    = $env:USERNAME                                                    

# Windows Info Variables
$os     = Get-CimInstance -ClassName Win32_OperatingSystem
$winCap = $os.Caption
$winVer = $os.Version
$winBld = $os.BuildNumber
$winArch= $os.OSArchitecture

# Disk Space Variables
$disk   = Get-CimInstance -ClassName Win32_LogicalDisk -Filter "DeviceID='C:'"
$free   = [math]::Round($disk.FreeSpace / 1GB, 2)
$fdperc = [math]::Round(($disk.FreeSpace / $disk.Size) * 100, 2)

Add-Content -Path $logfile -Value "================================"
Add-Content -Path $logfile -Value "A Weekly Log Has Been Generated!"
Add-Content -Path $logfile -Value "As of $dandt"
Add-Content -Path $logfile -Value "Computer: $comname"
Add-Content -Path $logfile -Value "Username: $user"
Add-Content -Path $logfile -Value "OS: $winCap ($winArch) | Version: $winVer | Build: $winBld `n"

#Available Disk Space
Add-Content -Path $logfile -Value "C: Drive Free Space: $free GB ($fdperc% free) `n"

#System File Checker
Add-Content -Path $logfile -Value "Running System File Checker (SFC)..."
$sfcResult = sfc /scannow
Add-Content -Path $logfile -Value "$sfcResult `n"

#Deployment Image Servicing and Management Restoration
Add-Content -Path $logfile -Value "Running DISM Health Check..."
$dismResult = DISM.exe /Online /Cleanup-Image /RestoreHealth
Add-Content -Path $logfile -Value "$dismResult `n"

Add-Content -Path $logfile -Value "================================ `n"
